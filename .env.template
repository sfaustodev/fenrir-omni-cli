# ============================================================================
# FENRIR 4.0 - AI API KEYS CONFIGURATION
# ============================================================================
# Copy this file to .env and add your API keys
# Never commit .env to git (it's in .gitignore)

# ----------------------------------------------------------------------------
# ZAI - FENRIR ORCHESTRATOR (Main Brain)
# ----------------------------------------------------------------------------
# Zai is the main orchestrator that makes strategic decisions
# Get your API key from: https://api.z.ai/api/paas/v4/chat/completions 
ZAI_API_KEY=your_zai_api_key_here

# ----------------------------------------------------------------------------
# BLACKBOX AI (General Tasks - Replaces Grok)
# ----------------------------------------------------------------------------
# Blackbox handles general security tasks with guard rails
# Get your API key from: https://www.blackbox.ai/
BLACKBOX_API_KEY=your_blackbox_api_key_here

# ----------------------------------------------------------------------------
# GEMINI (Translation Layer)
# ----------------------------------------------------------------------------
# Gemini translates natural language to commands
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# VENICE AI (Red Team - Aggressive Operations)
# ----------------------------------------------------------------------------
# Venice handles aggressive penetration testing (no guard rails)
# Get your API key from: https://venice.ai/
VENICE_API_KEY=your_venice_api_key_here
VENICE_API_URL=https://api.venice.ai/v1/chat/completions
VENICE_MODEL=llama-3.3-70b

# ============================================================================
# NOTES
# ============================================================================
# - ZAI_API_KEY: Required for orchestrator (main brain)
# - BLACKBOX_API_KEY: Required for general tasks and translation
# - GEMINI_API_KEY: Optional (for translation layer)
# - VENICE_API_KEY: Optional (for aggressive red team operations)
#
# Commands:
# - zai "prompt"     -> Query Zai Orchestrator (strategic decisions)
# - negao "prompt"   -> Query Blackbox AI (general tasks)
# - scan <target>    -> Security assessment
# - bite <target>    -> Penetration testing
#
# ============================================================================
